{
  "name": "dsh-branch-worktree",
  "version": "1.3.0",
  "description": "Pick a Git branch — or let the plugin name one for you — on the DeepSeek Harness New Session screen and start the conversation inside an automatically created worktree.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "git",
    "worktree",
    "branch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elfgzp/dsh-branch-worktree.git"
  },
  "homepage": "https://github.com/elfgzp/dsh-branch-worktree#readme",
  "bugs": {
    "url": "https://github.com/elfgzp/dsh-branch-worktree/issues"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs",
    "test:client": "node test/client.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
